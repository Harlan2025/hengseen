# 环境说明
VITE_ENV=production

# 后端API地址
# 开发环境: http://localhost:8000/api/v1
# 生产环境: https://api.hengseen.com/api/v1
VITE_API_URL=https://api.hengseen.com/api/v1

# 应用名称
VITE_APP_NAME=衡简叙约
