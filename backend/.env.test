# 测试配置 - 使用内存数据库和模拟AI
APP_NAME=衡简叙约-测试
APP_VERSION=1.4.0
DEBUG=true

# Supabase配置（测试模式使用内存）
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_KEY=test-service-key

# JWT配置
JWT_SECRET_KEY=test-jwt-secret-key-for-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI服务配置（测试模式使用模拟）
AI_BASE_URL=http://localhost:8000
AI_API_KEY=test-api-key
AI_MODEL=test-model
AI_MAX_TOKENS=4096
AI_MODE=mock  # mock | real

# 定价配置
PRICING_FIXED_THRESHOLD=2.0
PRICING_FIXED_PRICE=5.99
PRICING_MULTIPLIER=2.0

# 域名配置
DOMAIN=http://localhost:8000

# 测试开关
TEST_MODE=true
